<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil de PRODUCCION. Publica framework-dependent (Release) marcado como
     ASPNETCORE_ENVIRONMENT=Production. Incluye appsettings.json + appsettings.Production.json
     (BD 10.1.2.4 + imagenes en \\10.1.2.4\asistencias\imagenes). -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>C:\Desarrollo\PublishApi-Prod</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>4ceaea50-5500-42c1-bb4c-3a424d73391c</ProjectGuid>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>
</Project>
